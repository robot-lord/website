---
// A shell command with a copy button.
interface Props {
  cmd: string;
  label?: string;
}
const { cmd, label = "Copy command" } = Astro.props;
---

<div class="command">
  <code><span class="prompt" aria-hidden="true">$ </span>{cmd}</code>
  <button type="button" class="copy" data-copy={cmd} aria-label={label}>
    <span data-copy-text>Copy</span>
  </button>
</div>
