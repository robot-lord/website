---
// A terminal screenshot from docs/images, served as WebP in two widths.
interface Props {
  name: string;
  alt: string;
  caption?: string;
  eager?: boolean;
}
const { name, alt, caption, eager = false } = Astro.props;
---

<figure class="shot">
  <img
    src={`/img/${name}-1600.webp`}
    srcset={`/img/${name}-800.webp 800w, /img/${name}-1600.webp 1600w`}
    sizes="(min-width: 1140px) 1076px, calc(100vw - 2rem)"
    width="1600"
    height="940"
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
